{
  "uid": "ctv-overview",
  "title": "CTV - Overview",
  "description": "¿Los dos servicios están arriba y atendiendo?",
  "tags": ["ctv", "spring-boot"],
  "editable": false,
  "graphTooltip": 1,
  "links": [
    { "title": "Carga", "type": "link", "icon": "dashboard", "url": "/d/ctv-load", "keepTime": true }
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": false,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servicios",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "up{job=~\"backend|flights-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "noValue": "DOWN"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "process_uptime_seconds{job=~\"backend|flights-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "dtdurations", "noValue": "—" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memoria JVM (heap)",
      "description": "Usada contra el máximo. El máximo se dibuja solo si la JVM lo publica.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\",job=~\"backend|flights-service\"})",
          "legendFormat": "{{job}} usada",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        },
        {
          "expr": "sum by (job) (jvm_memory_max_bytes{area=\"heap\",job=~\"backend|flights-service\"} > 0)",
          "legendFormat": "{{job}} máxima",
          "refId": "B",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/máxima/" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 8] } },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests por segundo",
      "description": "Sin /actuator. El scrape de Prometheus no cuenta como tráfico.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"backend|flights-service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    }
  ]
}
