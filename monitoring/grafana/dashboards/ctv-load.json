{
  "uid": "ctv-load",
  "title": "CTV - Load",
  "description": "p95, errores, pool y circuit breaker mientras corre k6. Las líneas de esa ventana están en Kibana.",
  "tags": ["ctv", "spring-boot", "load"],
  "editable": false,
  "graphTooltip": 1,
  "links": [
    { "title": "Overview", "type": "link", "icon": "dashboard", "url": "/d/ctv-overview", "keepTime": true }
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": false,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP p95 por endpoint",
      "description": "Plantilla uri de Spring, sin /actuator ni OPTIONS sin ruta.",
      "gridPos": { "h": 9, "w": 15, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job, method, uri) (rate(http_server_requests_seconds_bucket{job=~\"backend|flights-service\",uri!~\"/actuator.*\",uri!=\"UNKNOWN\"}[$__rate_interval])))",
          "legendFormat": "{{job}} {{method}} {{uri}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max"] }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 5xx (req/s)",
      "description": "Cero es una línea, no un panel vacío.",
      "gridPos": { "h": 9, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"backend|flights-service\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval])) or sum by (job) (rate(http_server_requests_seconds_count{job=~\"backend|flights-service\",uri!~\"/actuator.*\"}[$__rate_interval]) * 0)",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "off" }
          },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hikari: activas, en espera y máximo",
      "description": "pending > 0 indica que el pool se quedó sin conexiones. La compra no retiene una conexión durante el HTTP a vuelos.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=~\"backend|flights-service\"}",
          "legendFormat": "{{job}} {{pool}} activas",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        },
        {
          "expr": "hikaricp_connections_pending{job=~\"backend|flights-service\"}",
          "legendFormat": "{{job}} {{pool}} en espera",
          "refId": "B",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        },
        {
          "expr": "hikaricp_connections_max{job=~\"backend|flights-service\"}",
          "legendFormat": "{{job}} {{pool}} máximo",
          "refId": "C",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/en espera/" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/máximo/" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 8] } },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Circuit breaker flightsService",
      "description": "Solo el estado activo, en 1. closed es el estado sano.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"flightsService\"} == 1",
          "legendFormat": "{{state}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/^closed$|^disabled$/" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^half_open$/" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^open$|^forced_open$/" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Búsqueda de paquetes p95",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(package_search_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    }
  ]
}
