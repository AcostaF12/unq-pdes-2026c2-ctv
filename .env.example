# Ejemplo de configuración de Compra tu Viaje.
#
# Uso local: cp .env.example .env
# Docker Compose lee .env automáticamente desde la raíz del repositorio.
# .env está en .gitignore: no versionar valores reales.
# Todos los valores de este archivo son de ejemplo y seguros para desarrollo.

# --- Docker Compose (docker-compose.yml y docker-compose.prod.yml) ---

# Puertos del host para las dos bases PostgreSQL. Cambiarlos si 5433 o 5434 están ocupados.
BACKEND_DB_PORT=5433
FLIGHTS_DB_PORT=5434

# Carga de datos de ejemplo en el overlay de la VM (docker-compose.prod.yml).
# En docker-compose.yml el perfil dev ya la habilita. false = instalación sin datos de ejemplo.
SEED_ENABLED=true

# Orígenes permitidos por CORS en el overlay de la VM, por ejemplo http://<IP-de-la-VM>:*
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# --- Backend: seguridad ---

# Clave para firmar los JWT (32 bytes o más). Este valor es solo un placeholder.
# En producción (VM) se define como secreto y nunca se versiona.
JWT_SECRET=reemplazar-por-una-clave-aleatoria-de-32-bytes-o-mas
# Duración del token en milisegundos (86400000 = 24 h).
# JWT_EXPIRATION_MS=86400000

# --- Referencia: variables que cada servicio lee al correr fuera de Docker ---
# docker-compose.yml ya las define para cada contenedor, por eso van comentadas.
# Para ./gradlew bootRun, exportarlas en la terminal del servicio correspondiente.

# Backend
# SPRING_PROFILES_ACTIVE=dev
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=backend_dev
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# FLIGHTS_SERVICE_URL=http://localhost:8081
# DDL_AUTO=validate

# Flights Service
# SPRING_PROFILES_ACTIVE=dev
# SERVER_PORT=8081
# DB_HOST=localhost
# DB_PORT=5434
# DB_NAME=flights_dev
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DDL_AUTO=validate

# Observabilidad (backend y flights-service)
# ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
# TRACING_SAMPLING_PROBABILITY=1.0
# LOGSTASH_HOST=localhost
# LOGSTASH_PORT=5000

# Frontend: URL del backend. Se fija al construir la imagen (build-arg VITE_API_BASE_URL);
# con npm run dev se toma de la terminal o de frontend/.env, no de este archivo.
# VITE_API_BASE_URL=http://localhost:8080

# --- Deploy (GitHub Actions) ---
# El workflow "Deploy Demo (Azure VM)" no usa este archivo. Lee estos secretos del repositorio
# en GitHub: AZURE_CREDENTIALS, VM_HOST, VM_USER, VM_SSH_KEY y SONAR_TOKEN.
